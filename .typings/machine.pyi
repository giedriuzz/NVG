from typing import Any

class Pin:
    IN: int
    OUT: int
    PULL_UP: int
    PULL_DOWN: int
    def __init__(self, id: int, mode: int = -1, pull: int = -1, *, value: Any = None) -> None: ...
    def value(self, x: Any = ...) -> int: ...
    def on(self) -> None: ...
    def off(self) -> None: ...

class ADC:
    ATTN_0DB: int
    ATTN_2_5DB: int
    ATTN_6DB: int
    ATTN_11DB: int
    def __init__(self, pin: Pin | int) -> None: ...
    def atten(self, attenuation: int) -> None: ...
    def read_u16(self) -> int: ...
    def read_uv(self) -> int: ...

class PWM:
    def __init__(self, dest: Pin | int, *, freq: int = ..., duty_u16: int = ..., duty_ns: int = ...) -> None: ...
    def freq(self, value: int = ...) -> int: ...
    def duty_u16(self, value: int = ...) -> int: ...
    def deinit(self) -> None: ...

class UART:
    def __init__(
        self,
        id: int,
        baudrate: int = 9600,
        bits: int = 8,
        parity: int | None = None,
        stop: int = 1,
        *,
        tx: Pin | int | None = None,
        rx: Pin | int | None = None,
        timeout: int = 0,
    ) -> None: ...
    def any(self) -> int: ...
    def read(self, nbytes: int = ...) -> bytes | None: ...
    def write(self, buf: bytes | bytearray) -> int | None: ...

def reset() -> None: ...
def freq(hz: int = ...) -> int: ...

